# Non-secret local settings for running the API outside Kubernetes. No credentials here, ever:
# boto3 resolves your identity from ~/.aws/ (outside the repo). Use `export` lines, not `source .env`.
MODEL_BUCKET=fraud-ecommerce
AWS_REGION=ap-south-2
MODEL_ALIAS_KEY=models/CURRENT.json
LOG_LEVEL=INFO
LOG_PREDICTIONS=false
ROLE=api
PORT=8000
